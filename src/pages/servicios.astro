---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import ServicesDetail from '@/components/sections/ServicesDetail.astro';
import Methodology from '@/components/sections/Methodology.astro';
import CallToAction from '@/components/sections/CallToAction.astro';
import { services } from '@/data/services';
import { siteConfig } from '@/data/site-config';
import { absoluteUrl } from '@/lib/url';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Áreas de especialización de ADROX',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.title,
        description: s.summary,
        provider: { '@id': `${absoluteUrl('/', Astro.site)}#organization` },
        areaServed: siteConfig.region,
        url: absoluteUrl(`/servicios#${s.id}`, Astro.site),
      },
    })),
  },
];
---

<BaseLayout
  title="Servicios"
  description="Software Engineering, AI & Data, Smart Systems y Digital Transformation: las áreas en las que ADROX diseña y desarrolla soluciones tecnológicas."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Servicios"
    title="Áreas de especialización"
    lead="Cuatro disciplinas complementarias para transformar desafíos empresariales, operativos e industriales en sistemas funcionales."
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Servicios' }]}
  >
    <ul class="mt-10 flex flex-wrap gap-2" aria-label="Ir a un área">
      {
        services.map((s) => (
          <li>
            <a href={`#${s.id}`} class="inline-flex items-center gap-2 rounded-[3px] border border-navy/15 bg-ivory-50 px-4 py-2 text-sm font-medium transition-colors hover:border-navy">
              <span class="font-mono text-xs text-navy-300">{s.index}</span>
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHeader>

  <section class="py-8 lg:py-12" aria-label="Detalle de servicios">
    <div class="container-site">
      <ServicesDetail />
      <p class="mt-10 max-w-3xl text-sm leading-relaxed text-navy-500">
        Las aplicaciones y problemas indicados describen el alcance de cada área de trabajo. ADROX es una iniciativa en
        construcción: varias de estas capacidades se han aplicado en proyectos propios, académicos o experimentales, y no
        representan experiencia comercial con clientes.
      </p>
    </div>
  </section>

  <Methodology index="" />
  <CallToAction />
</BaseLayout>
