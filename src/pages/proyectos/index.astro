---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import CallToAction from '@/components/sections/CallToAction.astro';
import { projects, categoryLabels, type ProjectCategory } from '@/data/projects';
import { absoluteUrl } from '@/lib/url';

const used = [...new Set(projects.map((p) => p.category))] as ProjectCategory[];
const filters = [
  { id: 'all', label: 'Todos', count: projects.length },
  ...used.map((c) => ({ id: c, label: categoryLabels[c], count: projects.filter((p) => p.category === c).length })),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Proyectos de ADROX',
    url: absoluteUrl('/proyectos', Astro.site),
    hasPart: projects.map((p) => ({
      '@type': 'CreativeWork',
      name: p.name,
      description: p.summary,
      url: absoluteUrl(`/proyectos/${p.slug}`, Astro.site),
    })),
  },
];
---

<BaseLayout
  title="Proyectos"
  description="Portafolio de proyectos tecnológicos de ADROX: software empresarial, visión artificial, IoT y procesamiento de señales, con el estado real de cada uno."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Portafolio"
    title="Proyectos y casos de estudio"
    lead="Proyectos desarrollados y en desarrollo. Cada caso de estudio describe el problema, la solución propuesta, la arquitectura y el estado actual, sin resultados que no estén documentados."
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Proyectos' }]}
  />

  <section class="py-16 lg:py-20" aria-label="Listado de proyectos">
    <div class="container-site">
      <div class="mb-10 hidden flex-wrap gap-2" role="group" aria-label="Filtrar por categoría" data-filter-bar>
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="inline-flex items-center gap-2 rounded-full border border-navy/15 px-4 py-2 text-sm font-medium text-navy-700 transition-colors hover:border-navy aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-ivory-50"
            >
              {f.label}
              <span class="font-mono text-xs opacity-60">{f.count}</span>
            </button>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>

      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-project-list>
        {
          projects.map((project, i) => (
            <li data-category={project.category} data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
              <ProjectCard project={project} index={i} headingLevel="h2" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CallToAction title="¿Quieres desarrollar un proyecto con ADROX?" />
</BaseLayout>

<script>
  // Filtro progresivo: sin JavaScript se muestran todos los proyectos.
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const items = document.querySelectorAll<HTMLElement>('[data-project-list] > li');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (bar) {
    bar.classList.remove('hidden');
    bar.classList.add('flex');
    const buttons = bar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let visible = 0;
        items.forEach((li) => {
          const show = filter === 'all' || li.dataset.category === filter;
          li.hidden = !show;
          if (show) {
            visible++;
            li.classList.add('is-visible');
          }
        });
        if (status) status.textContent = `${visible} ${visible === 1 ? 'proyecto' : 'proyectos'} mostrados.`;
      }),
    );
  }
</script>
