---
interface Props {
  href: string;
  current: boolean;
  class?: string;
}
const { href, current, class: className } = Astro.props;
---

<a
  href={href}
  aria-current={current ? 'page' : undefined}
  class:list={[
    'relative py-2 text-[0.9rem] tracking-[0.01em] transition-colors duration-300',
    'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-teal after:transition-transform after:duration-500 after:ease-(--ease-out-soft)',
    'hover:text-navy hover:after:scale-x-100 focus-visible:after:scale-x-100',
    current ? 'text-navy after:scale-x-100' : 'text-navy-500',
    className,
  ]}
>
  <slot />
</a>
