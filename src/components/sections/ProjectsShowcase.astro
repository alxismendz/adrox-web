---
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import Button from '../ui/Button.astro';
import { projects } from '@/data/projects';
---

<section id="proyectos" class="border-t border-navy/10 bg-ivory-200/40 py-24 lg:py-32" aria-labelledby="proyectos-title">
  <div class="container-site">
    <SectionHeading
      id="proyectos-title"
      index="02"
      eyebrow="Portafolio"
      title="Proyectos desarrollados y en desarrollo."
      lead="Casos técnicos que muestran cómo abordamos problemas reales con software, visión artificial, electrónica y procesamiento de señales. Cada uno indica con claridad su estado actual."
      align="split"
    />
    <ul class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <li data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
            <ProjectCard project={project} index={i} />
          </li>
        ))
      }
      <li class="flex" data-reveal style="--reveal-delay: 160ms">
        <div class="flex w-full flex-col justify-between rounded-[4px] border border-dashed border-navy/20 p-8">
          <div>
            <p class="eyebrow text-navy-500">Próximo proyecto</p>
            <p class="mt-4 text-[1.35rem] leading-snug font-medium">¿Tienes un desafío técnico que quieras resolver?</p>
            <p class="mt-3 leading-relaxed text-navy-500">
              Cuéntanos el problema y evaluaremos juntos una solución viable.
            </p>
          </div>
          <div class="mt-8">
            <Button href="/contacto" variant="secondary">Hablemos de tu proyecto</Button>
          </div>
        </div>
      </li>
    </ul>
    <div class="mt-12">
      <Button href="/proyectos" variant="ghost">Ver el portafolio completo</Button>
    </div>
  </div>
</section>
