---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { services } from '@/data/services';
---

<section id="servicios" class="py-24 lg:py-32" aria-labelledby="servicios-title">
  <div class="container-site">
    <SectionHeading
      id="servicios-title"
      index="01"
      eyebrow="Áreas de especialización"
      title="Cuatro disciplinas, una misma forma de resolver problemas."
      lead="Integramos ingeniería de software, inteligencia artificial, sistemas electrónicos y procesos para construir soluciones prácticas y escalables."
      align="split"
    />

    <ul class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-navy/10 bg-navy/10 md:grid-cols-2">
      {
        services.map((service, i) => (
          <li class="bg-ivory-50" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <a
              href={`/servicios#${service.id}`}
              class="group relative flex h-full flex-col p-8 transition-colors duration-500 hover:bg-white sm:p-10"
            >
              <div class="flex items-start justify-between">
                <span class="inline-flex size-12 items-center justify-center rounded-[3px] border border-navy/12 text-teal-700 transition-colors duration-500 group-hover:border-teal group-hover:bg-teal group-hover:text-ivory-50">
                  <Icon name={service.icon} size={22} />
                </span>
                <span class="font-mono text-xs text-navy-300">{service.index}</span>
              </div>
              <h3 class="mt-10 text-[1.45rem] font-medium">{service.title}</h3>
              <p class="mt-1 text-sm text-bronze-700">{service.subtitle}</p>
              <p class="mt-5 max-w-md leading-relaxed text-navy-500">{service.summary}</p>
              <span class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-navy">
                Aplicaciones y problemas que aborda
                <Icon name="arrow-right" size={15} class="transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <p class="max-w-2xl text-sm leading-relaxed text-navy-500">
        Estas son las áreas en las que ADROX desarrolla proyectos y capacidades técnicas. Varias de ellas se encuentran en
        fase de prototipo, investigación o desarrollo.
      </p>
      <Button href="/servicios" variant="secondary">Ver todos los servicios</Button>
    </div>
  </div>
</section>
