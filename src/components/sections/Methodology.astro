---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { methodology } from '@/data/methodology';

interface Props {
  index?: string;
}
const { index = '03' } = Astro.props;
---

<section id="metodologia" class="on-dark relative overflow-hidden bg-navy py-24 text-ivory lg:py-32" aria-labelledby="metodologia-title">
  <div class="bg-blueprint-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-site relative">
    <SectionHeading
      id="metodologia-title"
      index={index}
      eyebrow="Metodología"
      title="Un proceso de ingeniería claro, de la idea al sistema en funcionamiento."
      lead="Cada proyecto avanza por etapas definidas, con entregables verificables y decisiones documentadas."
      tone="light"
      align="split"
    />

    <ol class="relative mt-20 grid gap-0 lg:grid-cols-5">
      <span class="absolute top-6 right-0 left-0 hidden h-px bg-ivory/15 lg:block" aria-hidden="true"></span>
      <span class="absolute top-0 bottom-0 left-6 w-px bg-ivory/15 lg:hidden" aria-hidden="true"></span>
      {
        methodology.map((step, i) => (
          <li class="relative grid grid-cols-[3rem_1fr] gap-6 pb-12 last:pb-0 lg:block lg:pr-8 lg:pb-0" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <span class="relative z-10 inline-flex size-12 items-center justify-center rounded-full border border-ivory/25 bg-navy text-teal-300 transition-colors duration-500 hover:border-teal-300">
              <Icon name={step.icon} size={20} />
            </span>
            <div class="lg:mt-8">
              <p class="font-mono text-xs tracking-[0.16em] text-bronze-300">{step.index}</p>
              <h3 class="mt-2 text-[1.3rem] font-medium tracking-[0.02em] uppercase">{step.title}</h3>
              <p class="mt-3 font-medium text-ivory/90">{step.summary}</p>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-ivory/60">{step.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
