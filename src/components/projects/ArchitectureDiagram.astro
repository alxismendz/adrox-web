---
import Icon from '../ui/Icon.astro';
import type { ArchitectureLayer } from '@/data/projects';

interface Props {
  layers: ArchitectureLayer[];
  note?: string;
}
const { layers, note } = Astro.props;
---

<figure>
  <ol class="grid gap-3 sm:grid-cols-2 xl:grid-cols-none xl:auto-cols-fr xl:grid-flow-col" aria-label="Capas de la arquitectura">
    {
      layers.map((layer, i) => (
        <li class="relative">
          <div class="h-full rounded-[4px] border border-navy/12 bg-white p-5">
            <p class="font-mono text-[0.7rem] tracking-[0.14em] text-teal-700">{String(i + 1).padStart(2, '0')}</p>
            <p class="mt-2 font-medium">{layer.title}</p>
            <ul class="mt-3 space-y-1.5">
              {layer.items.map((item) => (
                <li class="font-mono text-[0.8rem] leading-snug text-navy-500">{item}</li>
              ))}
            </ul>
          </div>
          {i < layers.length - 1 && (
            <span class="absolute top-1/2 -right-3 z-10 hidden size-6 -translate-y-1/2 items-center justify-center rounded-full border border-navy/12 bg-ivory text-navy-500 xl:inline-flex" aria-hidden="true">
              <Icon name="arrow-right" size={12} />
            </span>
          )}
        </li>
      ))
    }
  </ol>
  {note && <figcaption class="mt-4 text-sm leading-relaxed text-navy-500">{note}</figcaption>}
</figure>
