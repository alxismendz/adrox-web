---
import ProjectVisual from './ProjectVisual.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import Tag from '../ui/Tag.astro';
import Icon from '../ui/Icon.astro';
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  index: number;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}
const { project, index, headingLevel: H = 'h3', class: className } = Astro.props;
const shown = project.technologies.slice(0, 4);
const rest = project.technologies.length - shown.length;
---

<article
  class:list={[
    'group relative flex h-full flex-col overflow-hidden rounded-[4px] border border-navy/10 bg-ivory-50 transition-[box-shadow,transform,border-color] duration-500 ease-(--ease-out-soft) hover:-translate-y-1 hover:border-navy/20 hover:shadow-[0_24px_48px_-28px_rgb(23_37_59/0.45)] focus-within:border-navy/30',
    className,
  ]}
  data-project-card
  data-category={project.category}
>
  <div class="relative">
    <ProjectVisual variant={project.visual} class="aspect-[40/26] transition-[filter] duration-700 group-hover:brightness-110" />
    <span class="absolute top-4 left-4 font-mono text-[0.7rem] tracking-[0.16em] text-ivory/70">
      {String(index + 1).padStart(2, '0')}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-7">
    <p class="eyebrow text-[0.68rem] text-navy-500">{project.categoryLabel}</p>
    <H class="mt-3 text-[1.45rem] leading-tight font-medium">
      <a href={`/proyectos/${project.slug}`} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
        {project.name}
      </a>
    </H>
    <p class="mt-3 leading-relaxed text-navy-500">{project.summary}</p>
    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tecnologías">
      {shown.map((t) => <li><Tag>{t}</Tag></li>)}
      {rest > 0 && <li><Tag>+{rest}</Tag></li>}
    </ul>
    <div class="mt-auto flex items-center justify-between gap-4 pt-7">
      <StatusBadge status={project.status} label={project.statusLabel} />
      <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-navy/15 text-navy transition-colors duration-300 group-hover:border-navy group-hover:bg-navy group-hover:text-ivory-50">
        <Icon name="arrow-up-right" size={16} />
      </span>
    </div>
  </div>
  <span class="pointer-events-none absolute inset-0 rounded-[4px] ring-2 ring-teal ring-offset-2 ring-offset-ivory opacity-0 group-has-[a:focus-visible]:opacity-100" aria-hidden="true"></span>
</article>
